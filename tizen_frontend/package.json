{
  "name": "tizen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "predev": "node ./scripts/check-node-version.cjs",
    "dev": "npm run predev && vite",
